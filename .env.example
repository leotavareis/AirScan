# Copie para .env e preencha.

DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Telegram: crie o bot com o @BotFather e rode `python manage.py telegram_teste` para descobrir o chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SerpApi (reserva): https://serpapi.com/manage-api-key
SERPAPI_API_KEY=
# Para de usar a SerpApi quando restarem estas buscas no mês (e avisa no Telegram).
SERPAPI_RESERVA_MINIMA=20

# Ordem dos provedores: o primeiro que responder vence.
AIRSCAN_PROVEDORES=fast_flights,serpapi
AIRSCAN_MOEDA=BRL
AIRSCAN_PAUSA_MIN=3
AIRSCAN_PAUSA_MAX=8
